# relay remote MCP — configuration template.
# Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Generate a strong random value:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- required: the remote surface stays OFF until this is set ---
RELAY_REMOTE_TOKEN=              # static admin bearer — the local PC / Flywheel path uses this

# --- bind + reachability ---
# RECOMMENDED path is a Cloudflare Tunnel (scripts/serve_cloudflared.ps1): no public
# IP, no port-forward, no CGNAT worry, no own cert. For it, use:
#   RELAY_REMOTE_HOST=127.0.0.1  (cloudflared reaches relay locally; leave TLS empty below)
# For the DIRECT port-forward path instead, use 0.0.0.0 and fill in TLS.
RELAY_REMOTE_HOST=127.0.0.1      # 127.0.0.1 behind a Cloudflare Tunnel; 0.0.0.0 for a direct port-forward
RELAY_REMOTE_PORT=8787           # relay's local port (a tunnel forwards to it; a router forwards 443 to it)

# --- TLS: fill ONLY for the direct port-forward path. Behind a Cloudflare Tunnel
#     leave BOTH empty -- Cloudflare provides the public cert. A direct path needs a
#     publicly-VALID CA cert (Let's Encrypt via win-acme); self-signed is rejected. ---
RELAY_TLS_CERT=                  # empty behind a tunnel; else e.g. C:\certs\relay-crt.pem
RELAY_TLS_KEY=                   # empty behind a tunnel; else e.g. C:\certs\relay-key.pem

# --- OAuth: required for the phone connector. Omit ALL of these to run bearer-only. ---
RELAY_PUBLIC_URL=                # your https origin. Behind a Cloudflare Tunnel this is your tunnel
                                 # hostname, e.g. https://relay.yourdomain.com; direct path: your DDNS
                                 # name, e.g. https://relay.yourname.duckdns.org (no trailing slash, no /mcp)
RELAY_OAUTH_CLIENT_ID=           # you choose it; enter the SAME value in the Claude connector dialog
RELAY_OAUTH_CLIENT_SECRET=       # you choose it; enter the SAME value in the Claude connector dialog
RELAY_OAUTH_SIGNING_SECRET=      # random; signs the access tokens
RELAY_AUTHORIZE_PASSWORD=        # you type this (any username) at the OAuth consent browser prompt
RELAY_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# --- origin allowlist: leave EMPTY. Anthropic's hosted connector reaches you
#     server-side (from 160.79.104.0/21), not with a browser Origin, so an
#     allowlist would falsely 403 the connect. ---
RELAY_ALLOWED_ORIGINS=

# --- remote exec: keep OFF. relay's shell is NOT confined to the workspace root,
#     so a phone-driven shell could reach outside it. Only set true if you accept that. ---
RELAY_ALLOW_REMOTE_EXEC=false
